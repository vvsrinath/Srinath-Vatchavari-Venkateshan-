# Optional: a JSON endpoint that returns LinkedIn certifications.
# LinkedIn does not offer an unauthenticated public API for certifications,
# so this can be a proxy-service endpoint you control (for example Proxycurl).
# Expected shape: [{ "title": "...", "issuer": "...", "date": "...", "url": "..." }]
LINKEDIN_CERTIFICATIONS_ENDPOINT=
LINKEDIN_CERTIFICATIONS_API_KEY=

# Optional: absolute site URL used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=
